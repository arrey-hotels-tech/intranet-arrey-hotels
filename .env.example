# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace padrão (id gerado ao rodar supabase/schema.sql)
DEFAULT_WORKSPACE_ID=

# Telegram (criar bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Sessão (qualquer string longa e aleatória)
SESSION_JWT_SECRET=

# Cloudflare R2 (buckets privados)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DEMANDS=arrey-demand-attachments
R2_BUCKET_TASKS=arrey-task-attachments
R2_BUCKET_MEDIA=arrey-intranet-media

# Cloudflare Turnstile (protecao do formulario publico)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
